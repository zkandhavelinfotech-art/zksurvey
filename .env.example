# Copy to .env and fill in. In production (NODE_ENV=production) the server refuses to start with unsafe values.
NODE_ENV=production
PORT=3000
APP_URL=https://app.example.com            # public https URL; used in emails, short links and Open Graph tags
# Database: Dual Support (PostgreSQL or MySQL)
# For PostgreSQL:
DATABASE_URL=postgres://zk:CHANGE_ME@localhost:5432/zksurvey
# For MySQL (e.g., Railway MySQL, PlanetScale, AWS RDS):
# DB_DIALECT=mysql
# MYSQL_URL=mysql://root:password@mysql.railway.internal:3306/railway
POSTGRES_PASSWORD=CHANGE_ME                # used by docker-compose
SERVER_SECRET=                             # 32+ random characters (openssl rand -hex 32); keys the stored IP hashes
TRUST_PROXY=1                              # number of reverse proxies in front of the app (set to true on Railway)

# First Super Admin (created on first start if none exists). Remove SUPER_PASSWORD from the file afterwards.
SUPER_EMAIL=
SUPER_PASSWORD=
SUPER_2FA=true                             # true in production; requires 6-digit email OTP for super admin

# Email (required in production for verification, password resets & 2FA codes)
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=ZKSurvey <no-reply@example.com>

# Payments & Billing
PAYMENT_MODE=both                          # upi | razorpay | both | mock (mock is refused in production)
# Instant UPI Payment Settings (GPay / PhonePe / BHIM / Paytm)
UPI_ID=zkandhavel@oksbi                    # your business VPA / UPI ID
UPI_NAME=ZK Software                      # Payee display name
AUTO_APPROVE_UPI=false                     # false = Super Admin approves UTR; true = auto-approves valid 12-digit UTR
# Razorpay Gateway (Optional alongside UPI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                   # set the same secret on the Razorpay dashboard webhook -> https://APP_URL/api/webhooks/razorpay

# Seller details printed on invoices (needed for a valid GST tax invoice)
SELLER_NAME=Zkandhavel Infotech Pvt Ltd
SELLER_GSTIN=
SELLER_STATE=Tamil Nadu
SELLER_ADDRESS=Chennai, Tamil Nadu, India
SELLER_SAC=998315
GST_RATE=18

